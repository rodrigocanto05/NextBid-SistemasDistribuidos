# Modelo das variáveis de ambiente do NextBid. O docker compose lê o ficheiro .env na raiz do projeto.
#
#   Criar o .env:  cp .env.example .env   (e trocar os valores "muda-..." antes de expor o site)
#
# O .env nunca vai para o Git (.gitignore). Nada de valores reais aqui.
# As passwords da base de dados e do RabbitMQ só são aplicadas quando os volumes são criados:
# para mudar depois, é preciso "docker compose down -v" (apaga os dados).

# Utilizador da aplicação no PostgreSQL (a API e os workers ligam-se com este)
DB_PASSWORD=muda-esta-password-app

# Superutilizador do PostgreSQL (só para administração e failover)
PG_ADMIN_PASSWORD=muda-esta-password-admin

# Utilizador de replicação (pg_basebackup e streaming entre os 3 nós)
PG_REPLICATION_PASSWORD=muda-esta-password-replicacao

# Segredo com que as APIs assinam e validam os JWT. Tem de ser o mesmo em todas (mín. 32 caracteres).
JWT_SECRET=muda-este-segredo-com-pelo-menos-32-caracteres

# Utilizador "nextbid" do RabbitMQ (APIs, workers e consola em http://localhost:15672)
RABBITMQ_PASSWORD=muda-esta-password-rabbitmq
